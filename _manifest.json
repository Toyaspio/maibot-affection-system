{
  "manifest_version": 2,
  "id": "feyumy.affection-system",
  "version": "1.3.12",
  "name": "好感度系统",
  "description": "基于 Feyumy 好感度系统的增强版：保留好感度追踪、自动评价及角色回应风格，新增本人主动查询的用户印象、长期摘要、有界历史取证与模型调用预算。",
  "author": {
    "name": "Feyumy",
    "url": "https://github.com/feiyunming"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/Toyaspio/maibot-affection-system",
    "homepage": "https://github.com/Toyaspio/maibot-affection-system",
    "documentation": "https://github.com/Toyaspio/maibot-affection-system/blob/main/README.md",
    "issues": "https://github.com/Toyaspio/maibot-affection-system/issues"
  },
  "host_application": {
    "min_version": "1.0.0",
    "max_version": "1.99.99"
  },
  "sdk": {
    "min_version": "2.0.0",
    "max_version": "2.99.99"
  },
  "plugin_type": "data",
  "dependencies": [
    {
      "type": "python_package",
      "name": "tomlkit",
      "version_spec": ">=0.13.3"
    }
  ],
  "capabilities": [
    "send.text",
    "chat.get_all_streams",
    "message.get_recent",
    "message.get_by_time_in_chat",
    "chat.get_group_streams",
    "person.get_id",
    "person.get_value",
    "person.get_id_by_name",
    "database.get",
    "llm.generate"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": [
      "zh-CN"
    ]
  }
}
